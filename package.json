{
  "name": "termlet",
  "version": "0.1.0",
  "type": "module",
  "description": "Pure frontend, pluggable pseudo-terminal kit for static sites and blogs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakahuote1/Termlet.git"
  },
  "bugs": {
    "url": "https://github.com/kakahuote1/Termlet/issues"
  },
  "homepage": "https://kakahuote1.github.io/Termlet/",
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./factory": "./src/factory.mjs",
    "./shell": "./src/shell.mjs",
    "./vfs": "./src/vfs.mjs",
    "./plugins/basic": "./src/plugins/basic-commands.mjs",
    "./plugins/system": "./src/plugins/system-commands.mjs",
    "./plugins/effects": "./src/plugins/effect-events.mjs",
    "./plugins/hugo": "./src/plugins/hugo-adapter.mjs",
    "./presets/blog-sandbox": "./src/presets/blog-sandbox.mjs",
    "./adapters/static-site": "./src/adapters/static-site.mjs",
    "./adapters/hugo": "./src/adapters/hugo.mjs",
    "./adapters/persistence": "./src/adapters/persistence.mjs",
    "./renderers/dom": "./src/renderers/dom-renderer.mjs",
    "./dist": "./dist/index.mjs",
    "./styles.css": "./dist/termlet.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "site:build": "npm run build && node scripts/build-site.mjs",
    "check": "node scripts/check.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "test": "node --test test/core.test.mjs",
    "verify": "npm run check && npm test && npm run security:scan && npm run site:build"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "examples",
    "site-src",
    "scripts",
    "test",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "terminal",
    "browser",
    "hugo",
    "static-site",
    "pseudo-terminal"
  ]
}
