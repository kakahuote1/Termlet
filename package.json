{
  "name": "termlet",
  "version": "0.3.0",
  "type": "module",
  "description": "Pure frontend, pluggable pseudo-terminal kit for static sites and blogs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakahuote1/Termlet.git"
  },
  "bugs": {
    "url": "https://github.com/kakahuote1/Termlet/issues"
  },
  "homepage": "https://kakahuote1.github.io/Termlet/",
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./factory": {
      "types": "./src/index.d.ts",
      "import": "./src/factory.mjs"
    },
    "./shell": {
      "types": "./src/index.d.ts",
      "import": "./src/shell.mjs"
    },
    "./extension": {
      "types": "./src/index.d.ts",
      "import": "./src/extension.mjs"
    },
    "./vfs": {
      "types": "./src/index.d.ts",
      "import": "./src/vfs.mjs"
    },
    "./plugins/basic": {
      "types": "./src/index.d.ts",
      "import": "./src/plugins/basic-commands.mjs"
    },
    "./plugins/system": {
      "types": "./src/index.d.ts",
      "import": "./src/plugins/system-commands.mjs"
    },
    "./plugins/effects": {
      "types": "./src/index.d.ts",
      "import": "./src/plugins/effect-events.mjs"
    },
    "./plugins/windows": {
      "types": "./src/index.d.ts",
      "import": "./src/plugins/windows-commands.mjs"
    },
    "./plugins/feed": {
      "types": "./src/index.d.ts",
      "import": "./src/plugins/feed-posts.mjs"
    },
    "./plugins/hugo": {
      "types": "./src/index.d.ts",
      "import": "./src/plugins/hugo-adapter.mjs"
    },
    "./presets/blog-sandbox": {
      "types": "./src/index.d.ts",
      "import": "./src/presets/blog-sandbox.mjs"
    },
    "./adapters/static-site": {
      "types": "./src/index.d.ts",
      "import": "./src/adapters/static-site.mjs"
    },
    "./adapters/starter": {
      "types": "./src/index.d.ts",
      "import": "./src/adapters/starter.mjs"
    },
    "./adapters/feed": {
      "types": "./src/index.d.ts",
      "import": "./src/adapters/feed.mjs"
    },
    "./adapters/hugo": {
      "types": "./src/index.d.ts",
      "import": "./src/adapters/hugo.mjs"
    },
    "./adapters/persistence": {
      "types": "./src/index.d.ts",
      "import": "./src/adapters/persistence.mjs"
    },
    "./renderers/dom": {
      "types": "./src/index.d.ts",
      "import": "./src/renderers/dom-renderer.mjs"
    },
    "./renderers/kit": {
      "types": "./src/index.d.ts",
      "import": "./src/renderers/renderer-kit.mjs"
    },
    "./dist": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/termlet.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "site:build": "npm run build && node scripts/build-site.mjs",
    "api:smoke": "node scripts/api-smoke.mjs",
    "check": "node scripts/check.mjs",
    "examples:smoke": "node scripts/examples-smoke.mjs",
    "bench": "node scripts/bench.mjs",
    "docs:smoke": "node scripts/docs-smoke.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "site:smoke": "node scripts/site-smoke.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run check && npm test && npm run bench && npm run docs:smoke && npm run examples:smoke && npm run security:scan && npm run site:build && npm run site:smoke"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "examples",
    "site-src",
    "scripts",
    "test",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "terminal",
    "browser",
    "hugo",
    "static-site",
    "pseudo-terminal"
  ]
}
